# Google Gemini API Configuration
# Add backup keys as _2, _3 etc. — if key _1 hits rate limits, _2 is used automatically.
NEXT_PUBLIC_GEMINI_API_KEY_1=your_primary_gemini_api_key_here
# NEXT_PUBLIC_GEMINI_API_KEY_2=your_second_backup_key_here
# NEXT_PUBLIC_GEMINI_API_KEY_3=your_third_backup_key_here

# Legacy single-key (still supported as a final fallback)
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

NEXT_PUBLIC_GEMINI_MODEL=gemini-3.5-flash-lite
